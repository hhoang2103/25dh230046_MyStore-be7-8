@model _25dh230046_MyStore.Models.Product

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">THÊM SẢN PHẨM </h2>


@using(Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <input type="file" name="UploadImage" />
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.Partial("PVCreateEditProduct", Model)
</div>

    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Tạo" class="btn btn-primary btn-sm mb-2" />
        @Html.ActionLink("Quay về", "Index", null, new { @class = "btn btn-primary btn-sm mb-2" })
    </div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
