@model _25dh230046_MyStore.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Customer Home Page";
    <link rel="stylesheet" type="text/css" href="~/Content/MyStyle/CustomerHome.css" />
}

<header>
    <ul class="navbar-nav ms-auto">
        @if (Session["TenTaiKhoan"] == null)
        {
            <!-- CHƯA ĐĂNG NHẬP -->
            <li class="nav-item">
                <a class="nav-link btn btn-outline-primary me-2 px-3 text-dark" href="@Url.Action("Login", "Account", new { area = "Admin" })">Đăng nhập</a>
            </li>
            <li class="nav-item">
                <a class="nav-link btn btn-primary text-white px-3" href="@Url.Action("Register", "Account", new { area = "Admin" })">Đăng ký</a>
            </li>
        }
        else
        {
            <!-- ĐÃ ĐĂNG NHẬP -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Chào, @Session["TenTaiKhoan"].ToString()
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account", new { area = "Admin" })">Đăng xuất</a></li>
                </ul>
            </li>
        }
    </ul>
</header>

@* PHẦN BANNER *@
<section class="container-fluid banner" style="background-color: #6673d0; padding: 40px 0; text-align: center;">
    <div class="banner-container">
        <h2 style="color: #ffffff !important;">Chào mừng đến thư viện sách lớn nhất thế giới</h2>
        <p style="color: #cccccc !important;">Mua sắm trực tuyến với hàng ngàn sản phẩm đa dạng và chất lượng</p>
        <a href="#" class="btnBanner">Bắt đầu mua sắm</a>
    </div>
</section>

@* PHẦN TÌM KIẾM SẢN PHẨM *@
<section class="container-fluid searchProd">
    <h2>Tìm kiếm sản phẩm</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="form-group search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new
            {
                @class = "search-input",
                placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm"
            })

            <button type="submit" class="search-button">Tìm kiếm</button>
        </div>
    }
</section>
<hr />

@* PHẦN SẢN PHẨM NỔI BẬT *@
@Html.Partial("PVFeatureProduct", Model)

@* PHẦN SẢN PHẨM MỚI *@
@Html.Partial("PVNewProduct", Model)

